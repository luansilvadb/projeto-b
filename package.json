    "check-script": "tsx scripts/check-script.ts",
    "narrate": "tsx scripts/narrate.ts",
    "voice": "tsx scripts/voice-studio.ts",
    "eval:voice": "tsx scripts/eval-voice.ts",
    "music": "tsx scripts/music.ts",
    "sfx": "tsx scripts/sfx.ts",
    "stills": "tsx scripts/stills.ts",
    "critique": "tsx scripts/critique.ts",
    "render": "remotion render",
    "scene": "tsx scripts/scene.ts",
    "join": "tsx scripts/join.ts",
    "sound": "remotion render --config=remotion.sound.config.ts",
    "setup:tools": "tsx scripts/setup-tools.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/media": "4.0.533",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.533",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "private": true
